{
  "name": "progress-tracking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "typecheck": "tsc --build --force && tsc --noEmit -p apps/web && tsc --noEmit -p packages/engine/tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:engine": "vitest run --project engine",
    "test:web": "vitest run --project web",
    "test:coverage": "vitest run --project engine --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "install:all": "pnpm install && pnpm db:generate",
    "db:generate": "prisma generate",
    "db:migrate": "node tools/db/apply-migrations.mjs",
    "db:seed": "tsx packages/db/src/seed/cli.ts",
    "db:seed:sql:gen": "tsx packages/db/src/seed/write-sql.ts",
    "db:validate": "prisma validate",
    "docs:build-arch": "node tools/docs/build-architecture.mjs",
    "auth:grant": "node tools/auth/grant-role.mjs",
    "auth:testuser": "node tools/auth/add-basic-user.mjs",
    "seed:admin": "node tools/auth/seed-admin.mjs",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "web:build": "pnpm --filter @app/web build",
    "web:serve": "pnpm --filter @app/web preview",
    "web:start": "pnpm --filter @app/web start",
    "smoke": "node tools/smoke/smoke.mjs",
    "reconcile": "node tools/smoke/reconcile.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "pg": "^8.13.1"
  },
  "pnpm": {
    "//": "KHÔNG chạy script cài đặt của các gói Prisma: postinstall của @prisma/engines tải binary Rust từ CDN (binaries.prisma.sh) và làm `pnpm install` chết khi máy chặn mạng. Client dùng WASM + driver `pg` nên không cần binary đó — xem packages/db/prisma/schema.prisma và tools/db/apply-migrations.mjs.",
    "neverBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "@prisma/client"
    ]
  }
}
