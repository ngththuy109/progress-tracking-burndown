{
  "name": "progress-tracking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "typecheck": "tsc --build --force && tsc --noEmit -p apps/web && tsc --noEmit -p packages/engine/tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:engine": "vitest run --project engine",
    "test:web": "vitest run --project web",
    "test:coverage": "vitest run --project engine --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:validate": "prisma validate --schema packages/db/prisma/schema.prisma",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "smoke": "node tools/smoke/smoke.mjs",
    "reconcile": "node tools/smoke/reconcile.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.18.0",
    "prisma": "6.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
