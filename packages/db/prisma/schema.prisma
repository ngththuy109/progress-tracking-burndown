// Schema PostgreSQL — nguồn sự thật là PRD §4.6.
//
// THỨ TỰ TẠO BẢNG khi viết migration (PRD §4.6 có ghi chú riêng):
//   work_calendar → calendar_holiday → tracked_epic → còn lại
// Có hai khoá ngoại đi ngược thứ tự đọc:
//   - tracked_epic  → work_calendar
//   - phase_rollup  → tracked_epic
//
// Quy ước (CONVENTIONS.md):
//   C-1  mốc thời gian dùng TIMESTAMPTZ lưu UTC; ngày thuần dùng DATE
//   C-2  thời lượng lưu bằng GIÂY, kiểu BigInt, hậu tố cột _s
//   C-3  bảng và cột snake_case số ít; đổi sang camelCase ở tầng repository
//   C-13 CẤM sửa migration đã merge — cần đổi schema thì tạo migration mới

// Dùng vị trí sinh mặc định (node_modules/.prisma/client).
// Custom `output` gây lỗi "Could not resolve @prisma/client" với pnpm workspace:
// Prisma dò package theo đường dẫn thật của thư mục output, không đi qua symlink.
//
// KHÔNG dùng native query engine (binary Rust tải từ CDN binaries.prisma.sh).
// Máy dev chặn mạng ra ngoài không tải được binary đó → `pnpm install` và
// `prisma generate` cùng chết.
//
// `engineType = "client"` chuyển client sang query compiler WASM (đóng gói sẵn
// trong @prisma/client, không tải gì) và thực thi truy vấn qua driver adapter —
// ở đây là `pg` thuần JS, xem client.ts. Không cần binary native nào.
//
// Ràng buộc đi kèm: engine "client" BẮT BUỘC `new PrismaClient()` nhận một
// `adapter`; client trần sẽ ném lỗi lúc chạy. Mọi nơi tạo client đi qua
// getPrisma()/createPrismaClient().
//
// (Ở 6.19.3, `driverAdapters` và `queryCompiler` đã rời preview nên KHÔNG khai
// trong previewFeatures nữa — khai vào sẽ bị cảnh báo "deprecated".)
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Bảng 1: Cây issue (Epic / Phase Task / Sub-task chung 1 bảng)
// ============================================================================
model JiraIssue {
  issueKey  String @id @map("issue_key") @db.VarChar(32)
  // ID số của Jira. KHÔNG unique toàn cục nữa: hai Jira site khác nhau có thể
  // trùng ID số — chỉ unique TRONG một project (tenant), xem uq_issue_project_id.
  issueId   BigInt @map("issue_id")
  // Vai trò trong cây, KHÔNG còn là vị trí cứng: tầng 0 = EPIC, tầng lá =
  // SUBTASK, tầng lá-1 = TASK (khi depth >= 2), các tầng giữa khác = MIDDLE.
  // Mọi SQL tổng hợp lọc issue_type='SUBTASK' nên MIDDLE tự động đứng ngoài.
  issueType String @map("issue_type") @db.VarChar(16) // EPIC | TASK | SUBTASK | MIDDLE

  // Tenant sở hữu issue này. Key Jira dạng <PROJECT>-<n> nên issue_key vẫn
  // unique toàn cục được — cột này chỉ để scope truy vấn + phân biệt issue_id.
  projectKey String @map("project_key") @db.VarChar(32)
  // Vị trí tầng thật trong cây: 0 = root, 1..depth. Giữ song song với issueType
  // (vai trò) để UI hiển thị đúng cấu trúc 1..N tầng của từng dự án.
  tierIndex  Int    @default(2) @map("tier_index") @db.SmallInt

  parentKey String? @map("parent_key") @db.VarChar(32)
  epicKey   String? @map("epic_key") @db.VarChar(32)
  summary   String

  // Kết quả phân tách tiêu đề Task (PRD §2.2)
  phaseCode     String? @map("phase_code") @db.VarChar(24)
  rawPhaseLabel String? @map("raw_phase_label")

  statusId       String @map("status_id") @db.VarChar(16)
  statusCategory String @map("status_category") @db.VarChar(16) // new | indeterminate | done

  originalEstimateS  BigInt @default(0) @map("original_estimate_s")
  remainingEstimateS BigInt @default(0) @map("remaining_estimate_s")
  timeSpentS         BigInt @default(0) @map("time_spent_s")

  // ---- Ngày kế hoạch của RIÊNG issue này (PRD §2.7, §2.8) ----
  // Đọc từ 2 custom field `wbs_start_date` / `wbs_end_date`; mã field khác nhau
  // ở mỗi Jira nên do T-05 dò ra, không viết cứng.
  //
  // Chỉ Sub-task mới có. Đây là NGUỒN của `phase_rollup.plan_start/plan_end`
  // (MIN/MAX) và của từng ô Signboard. Không lưu ở đây thì không tổng hợp được
  // và cũng không chỉ ra được Sub-task nào còn thiếu ngày.
  //
  // NULL = chưa điền trên Jira → ô Signboard là `NoPlan`, và cộng vào
  // `missing_date_count`. Rủi ro R-08 nói ca này chắc chắn xảy ra thật.
  wbsStartDate DateTime? @map("wbs_start_date") @db.Date
  wbsEndDate   DateTime? @map("wbs_end_date") @db.Date

  jiraCreatedAt DateTime  @map("jira_created_at") @db.Timestamptz(6)
  jiraUpdatedAt DateTime  @map("jira_updated_at") @db.Timestamptz(6)
  // NULL = còn trong Epic. KHÔNG BAO GIỜ xoá cứng — snapshot của những ngày
  // trước khi gỡ vẫn phải nhìn thấy issue này.
  removedAt     DateTime? @map("removed_at") @db.Timestamptz(6)
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  // ---- Kết quả phân tách tiêu đề Sub-task (PRD §2.9) ----
  // Phân tách MỘT LẦN lúc đồng bộ, không phân tách lại mỗi lần đọc.
  // Chỉ có giá trị với issueType = SUBTASK.
  sbProject String? @map("sb_project") @db.VarChar(64)
  sbTeam    String? @map("sb_team") @db.VarChar(64)
  // [Phase] trong TIÊU ĐỀ — chỉ để đối chiếu, KHÔNG dùng để phân loại.
  // Phase của Task cha luôn thắng (PRD §2.9.2).
  sbPhaseRaw String? @map("sb_phase_raw") @db.VarChar(64)

  functionName String? @map("function_name") @db.VarChar(128) // dạng hiển thị, giữ nguyên gốc
  functionKey  String? @map("function_key") @db.VarChar(128) // NFKC + lowercase, để GỘP HÀNG
  taskType     String? @map("task_type") @db.VarChar(32) // NULL nếu không khớp cột nào
  // TaskName THÔ bóc từ tiêu đề, giữ nguyên kể cả khi không khớp cột nào —
  // nguồn để màn hình gợi ý cột Signboard mới (PRD E-29).
  sbTaskRaw    String? @map("sb_task_raw") @db.VarChar(64)

  sbParseStatus String @default("UNPARSED") @map("sb_parse_status") @db.VarChar(24)

  // ---- Data quality: "không cần sửa dữ liệu" (màn hình Monitoring) ----
  // true = người vận hành đã xác nhận ticket này CỐ Ý thiếu dữ liệu → loại khỏi
  // các số đo Data quality (cả tử số lẫn mẫu số). Ghi ai/lúc nào để truy vết.
  dqExempt   Boolean   @default(false) @map("dq_exempt")
  dqExemptBy String?   @map("dq_exempt_by") @db.VarChar(254)
  dqExemptAt DateTime? @map("dq_exempt_at") @db.Timestamptz(6)

  parent      JiraIssue?          @relation("IssueTree", fields: [parentKey], references: [issueKey], onDelete: NoAction, onUpdate: NoAction)
  children    JiraIssue[]         @relation("IssueTree")
  actualDates SubtaskActualDates?
  project     Project             @relation(fields: [projectKey], references: [projectKey], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectKey, issueId], map: "uq_issue_project_id")
  @@index([epicKey, issueType], map: "idx_issue_epic")
  @@index([parentKey], map: "idx_issue_parent")
  @@index([jiraUpdatedAt(sort: Desc)], map: "idx_issue_updated")
  @@index([projectKey, issueType], map: "idx_issue_project_type")
  @@map("jira_issue")
}

// ============================================================================
// Bảng 2: Nhật ký thay đổi (chỉ giữ những trường ta quan tâm)
// ============================================================================
model IssueChangelogEvent {
  id            BigInt   @id @default(autoincrement())
  issueKey      String   @map("issue_key") @db.VarChar(32)
  jiraHistoryId BigInt   @map("jira_history_id")
  // status | timeestimate | timeoriginalestimate | parent | summary
  fieldName     String   @map("field_name") @db.VarChar(48)
  fromValue     String?  @map("from_value")
  toValue       String?  @map("to_value")
  changedAt     DateTime @map("changed_at") @db.Timestamptz(6)
  authorId      String?  @map("author_id") @db.VarChar(64)

  // Chống ghi trùng khi job chạy lại (C-6)
  @@unique([issueKey, jiraHistoryId, fieldName], map: "uq_changelog")
  // Index phục vụ truy vấn nóng nhất của engine:
  // "sự kiện gần nhất của trường X, trước thời điểm T"
  @@index([issueKey, fieldName, changedAt(sort: Desc)], map: "idx_changelog_lookup")
  @@map("issue_changelog_event")
}

// ============================================================================
// Bảng 3: Nhật ký log giờ
// ============================================================================
model WorklogEntry {
  // ID gốc từ Jira — chỉ unique TRONG MỘT SITE nên PK ghép với project_key:
  // hai tenant ở hai Jira site khác nhau có thể trùng worklog_id số.
  worklogId  BigInt @map("worklog_id")
  projectKey String @map("project_key") @db.VarChar(32)
  issueKey  String @map("issue_key") @db.VarChar(32)
  epicKey   String @map("epic_key") @db.VarChar(32)
  authorId  String? @map("author_id") @db.VarChar(64)

  timeSpentS BigInt @map("time_spent_s")

  // started = ngày NGƯỜI DÙNG khai đã làm. Engine LUÔN lọc theo trường này,
  // không theo createdAt (PRD E-03).
  startedAt DateTime @map("started_at") @db.Timestamptz(6)
  createdAt DateTime @map("created_at") @db.Timestamptz(6) // ngày BẤM NÚT log
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  isDeleted Boolean @default(false) @map("is_deleted")

  @@id([projectKey, worklogId])
  @@index([issueKey, startedAt], map: "idx_worklog_issue_started")
  @@index([epicKey, startedAt], map: "idx_worklog_epic_started")
  @@map("worklog_entry")
}

// ============================================================================
// Bảng 4: Sổ đăng ký Epic đang theo dõi (PRD §2.6)
// Nguồn DUY NHẤT trả lời "job đêm phải chạy cho Epic nào".
// ============================================================================
model TrackedEpic {
  // "Epic" từ multi-tenant nghĩa là "TRACKED ROOT" — issue gốc của phạm vi theo
  // dõi, không nhất thiết là issue type Epic của Jira (dự án 1 tầng có thể dùng
  // bất kỳ issue cha nào). Giữ tên bảng/cột cũ để không đụng engine + repository.
  epicKey     String @id @map("epic_key") @db.VarChar(32)
  // ID số per-site → không unique toàn cục (hai site có thể trùng số).
  epicId      BigInt @map("epic_id")
  projectKey  String @map("project_key") @db.VarChar(32)
  displayName String @map("display_name")

  // ROOT_ISSUE = phạm vi là cây con dưới epicKey (v1).
  // JQL        = phạm vi là kết quả rootJql (dành cho dự án phẳng — chưa bật ở v1).
  scopeType String  @default("ROOT_ISSUE") @map("scope_type") @db.VarChar(16)
  rootJql   String? @map("root_jql")

  // PENDING | BACKFILLING | ACTIVE | PAUSED | ERROR
  status String @default("PENDING") @db.VarChar(16)

  // Hai trường này trước đây nằm ở bảng epic_baseline (đã bỏ từ PRD v1.2)
  timezone   String @db.VarChar(48) // IANA, ví dụ Asia/Ho_Chi_Minh
  calendarId String @map("calendar_id") @db.VarChar(32)

  // 254 = độ dài email tối đa (RFC 5321): `added_by` lưu chính danh tính người
  // thêm (email do SSO xác thực). Nới từ 64 ở migration 20260809000000_app_user.
  addedBy      String    @map("added_by") @db.VarChar(254)
  addedAt      DateTime  @default(now()) @map("added_at") @db.Timestamptz(6)
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  lastError    String?   @map("last_error")
  note         String?

  calendar     WorkCalendar @relation(fields: [calendarId], references: [calendarId])
  phaseRollups PhaseRollup[]
  project      Project      @relation(fields: [projectKey], references: [projectKey], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectKey], map: "idx_tracked_project")
  @@map("tracked_epic")
}

// ============================================================================
// Bảng 5: Snapshot chốt sổ hằng ngày (bảng chính để vẽ biểu đồ)
// ============================================================================
model DailySnapshot {
  id            BigInt   @id @default(autoincrement())
  epicKey       String   @map("epic_key") @db.VarChar(32)
  snapshotDate  DateTime @map("snapshot_date") @db.Date // theo giờ ĐỊA PHƯƠNG
  snapshotAtUtc DateTime @map("snapshot_at_utc") @db.Timestamptz(6) // 23:59:59 quy về UTC

  plannedRemainingS BigInt @map("planned_remaining_s")
  actualRemainingS  BigInt @map("actual_remaining_s")

  // Tổng ước lượng của các Sub-task ĐANG HOẠT ĐỘNG tại T_d.
  // KHÔNG còn là "scope đóng băng" — baseline đã bị bỏ (PRD §4.3).
  totalScopeS BigInt @map("total_scope_s")
  totalSpentS BigInt @map("total_spent_s")

  // Chênh lệch so với snapshot NGÀY HÔM TRƯỚC (không so với baseline).
  scopeAddedS   BigInt @default(0) @map("scope_added_s")
  scopeRemovedS BigInt @default(0) @map("scope_removed_s")

  countTodo       Int @default(0) @map("count_todo")
  countInProgress Int @default(0) @map("count_in_progress")
  countDone       Int @default(0) @map("count_done")

  perPhase     Json     @map("per_phase")
  isRecomputed Boolean  @default(false) @map("is_recomputed")
  computedAt   DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  // Mốc job ĐỌC dữ liệu từ Jira (khác computedAt là lúc TÍNH xong).
  // Dùng để chống ghi đè bằng dữ liệu cũ — xem E-19.
  sourceReadAt DateTime @map("source_read_at") @db.Timestamptz(6)

  // Khoá này chính là thứ đảm bảo chạy lại không nhân đôi (C-6)
  @@unique([epicKey, snapshotDate], map: "uq_snapshot")
  @@index([epicKey, snapshotDate(sort: Asc)], map: "idx_snapshot_chart")
  @@map("daily_snapshot")
}

// ============================================================================
// Bảng 6: Nhật ký chạy job (để vận hành và điều tra sự cố)
// ============================================================================
model SyncRun {
  id      BigInt @id @default(autoincrement())
  epicKey String @map("epic_key") @db.VarChar(32)
  // Tenant sở hữu lần chạy — màn hình ops lọc theo dự án, và còn tra được
  // cả khi epic đã bị gỡ khỏi sổ đăng ký.
  projectKey String @map("project_key") @db.VarChar(32)
  runType String @map("run_type") @db.VarChar(16) // DAILY | BACKFILL | RECOMPUTE | MANUAL
  status  String @db.VarChar(16) // RUNNING | SUCCESS | FAILED | SKIPPED

  watermarkBefore DateTime? @map("watermark_before") @db.Timestamptz(6)
  watermarkAfter  DateTime? @map("watermark_after") @db.Timestamptz(6)

  daysComputed  Int  @default(0) @map("days_computed")
  apiCallsMade  Int  @default(0) @map("api_calls_made")
  rateLimitHits Int  @default(0) @map("rate_limit_hits")
  durationMs    Int? @map("duration_ms")
  errorMessage  String? @map("error_message")
  // Bước đang chạy khi job ném lỗi (FETCH_TREE | FETCH_HISTORY | PERSIST |
  // FINALIZE) và stack trace nguyên văn — màn hình Monitoring dẫn tới đây để
  // trả lời "lỗi ở đâu, nguyên nhân gì" thay vì chỉ một dòng error_message.
  errorStep    String? @map("error_step") @db.VarChar(32)
  errorDetail  String? @map("error_detail")

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([epicKey, startedAt(sort: Desc)], map: "idx_syncrun_recent")
  @@index([projectKey, startedAt(sort: Desc)], map: "idx_syncrun_project")
  @@map("sync_run")
}

// ============================================================================
// Bảng 7A: Bộ cấu hình nhận diện Phase (có version, quay lại được)
// PM tự sửa qua màn hình quản trị — xem PRD §2.2
// ============================================================================
model PhaseConfigSet {
  id         BigInt  @id @default(autoincrement())
  scope      String  @db.VarChar(16) // GLOBAL | PROJECT
  projectKey String? @map("project_key") @db.VarChar(32) // NULL khi scope = GLOBAL
  version    Int
  isActive   Boolean @default(false) @map("is_active")

  // Ô tích "nếu không mẫu nào khớp thì tìm từ khoá trên cả tiêu đề"
  fallbackScanFullTitle Boolean @default(true) @map("fallback_scan_full_title")

  createdBy String   @map("created_by") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  note      String? // PM ghi lý do sửa

  titlePatterns        PhaseTitlePattern[]
  subtaskTitlePatterns SubtaskTitlePattern[]
  phaseDefinitions     PhaseDefinition[]
  matchRules           PhaseMatchRule[]
  signboardColumns     SignboardColumn[]
  subPhaseOrders       SubPhaseOrder[]
  project              Project? @relation(fields: [projectKey], references: [projectKey], onDelete: NoAction, onUpdate: NoAction)

  @@unique([scope, projectKey, version], map: "uq_config_version")
  @@map("phase_config_set")
}

// ============================================================================
// Bảng 7B: TẦNG 1 — Mẫu tiêu đề Task (bóc tên Phase ra khỏi summary)
// ============================================================================
model PhaseTitlePattern {
  id          BigInt @id @default(autoincrement())
  configSetId BigInt @map("config_set_id")

  patternText String @map("pattern_text") // PM gõ: '[Phase] {name}'
  // Regex hệ thống TỰ SINH từ patternText. Lưu để tra khi debug,
  // KHÔNG cho PM sửa trực tiếp.
  compiledRegex String @map("compiled_regex")

  sortOrder Int @map("sort_order") // thử lần lượt từ nhỏ đến lớn

  configSet PhaseConfigSet @relation(fields: [configSetId], references: [id], onDelete: Cascade)

  @@index([configSetId, sortOrder], map: "idx_pattern_set")
  @@map("phase_title_pattern")
}

// ============================================================================
// Bảng 7C: Định nghĩa Phase chuẩn (mã, tên hiển thị, màu, thứ tự)
// ============================================================================
model PhaseDefinition {
  id          BigInt @id @default(autoincrement())
  configSetId BigInt @map("config_set_id")

  phaseCode String  @map("phase_code") @db.VarChar(24)
  labelVi   String  @map("label_vi")
  labelJa   String? @map("label_ja")
  colorHex  String? @map("color_hex") @db.Char(7)

  // Thứ tự HIỂN THỊ trên biểu đồ. KHÁC với matchPriority ở bảng 7D.
  // Xem giải thích ở PRD §2.2.3.
  displayOrder Int @map("display_order")

  configSet PhaseConfigSet @relation(fields: [configSetId], references: [id], onDelete: Cascade)

  @@unique([configSetId, phaseCode], map: "uq_phase_code")
  @@map("phase_definition")
}

// ============================================================================
// Bảng 7D: TẦNG 2 — Luật khớp từ khoá → Phase
// ============================================================================
model PhaseMatchRule {
  id          BigInt @id @default(autoincrement())
  configSetId BigInt @map("config_set_id")

  keyword   String // '基本設計' hoặc '^SP-\d+' nếu là regex
  matchMode String @default("CONTAINS") @map("match_mode") @db.VarChar(16) // CONTAINS | REGEX
  phaseCode String @map("phase_code") @db.VarChar(24)

  // Thứ tự ƯU TIÊN KHI KHỚP, số nhỏ thắng. KHÁC với displayOrder.
  // Khi bằng nhau: từ khoá DÀI HƠN thắng (PRD §2.2.3).
  matchPriority Int @default(50) @map("match_priority")

  configSet PhaseConfigSet @relation(fields: [configSetId], references: [id], onDelete: Cascade)

  @@index([configSetId, matchPriority], map: "idx_rule_set")
  @@map("phase_match_rule")
}

// ============================================================================
// Bảng 7E: Mẫu tiêu đề SUB-TASK (PRD §2.9)
// Khác bảng 7B — bảng đó dành cho tiêu đề Task (Phase).
// ============================================================================
model SubtaskTitlePattern {
  id          BigInt @id @default(autoincrement())
  configSetId BigInt @map("config_set_id")

  // PM gõ: '[{project}][{team}][{phase}][{function}]_{task}'
  patternText   String @map("pattern_text")
  compiledRegex String @map("compiled_regex")

  sortOrder Int @map("sort_order")

  configSet PhaseConfigSet @relation(fields: [configSetId], references: [id], onDelete: Cascade)

  @@index([configSetId, sortOrder], map: "idx_subtask_pattern_set")
  @@map("subtask_title_pattern")
}

// ============================================================================
// Bảng 7F: Cột của bảng Signboard (PRD §2.9.3)
// Danh sách loại task: Create, BALReview, FixCommentBAL, ...
// ============================================================================
model SignboardColumn {
  id          BigInt @id @default(autoincrement())
  configSetId BigInt @map("config_set_id")

  // KHỚP CHÍNH XÁC, không phải từ khoá kiểu "chứa" (PRD §2.9.3)
  taskCode String  @map("task_code") @db.VarChar(32)
  labelVi  String  @map("label_vi")
  labelJa  String? @map("label_ja")

  // Phía làm loại task này: VN (người làm) | JP (khách hàng review) — T-37.
  // Quyết định ngày kế hoạch của Sub-task được kiểm tra với lịch nghỉ nào.
  side String @default("VN") @db.VarChar(2)

  displayOrder Int @map("display_order") // thứ tự cột, trái sang phải

  configSet PhaseConfigSet @relation(fields: [configSetId], references: [id], onDelete: Cascade)

  @@unique([configSetId, taskCode], map: "uq_task_code")
  @@index([configSetId, displayOrder], map: "idx_sbcolumn_set")
  @@map("signboard_column")
}

// ============================================================================
// Bảng 7G: Thứ tự Sub-phase TRONG TỪNG PHASE trên bảng Signboard (PRD §6.1)
//
// KHÁC 7C: `display_order` của 7C là thứ tự PHASE trên biểu đồ; bảng này là thứ
// tự các NHÓM CỘT Sub-phase khi mở một Phase trên Signboard. Sub-phase là thứ
// của từng dự án nên tách bảng riêng — không nhét chung vào phase_definition.
// `sub_phase_code` so với `[Sub-phase]` trong tiêu đề SAU chuẩn hoá (E-31).
// Phase không có Sub-phase thì không có dòng nào — không phải khai.
// ============================================================================
model SubPhaseOrder {
  id          BigInt @id @default(autoincrement())
  configSetId BigInt @map("config_set_id")

  phaseCode    String @map("phase_code") @db.VarChar(24)
  subPhaseCode String @map("sub_phase_code") @db.VarChar(64)

  displayOrder Int @map("display_order") // thứ tự nhóm, trái sang phải

  configSet PhaseConfigSet @relation(fields: [configSetId], references: [id], onDelete: Cascade)

  @@unique([configSetId, phaseCode, subPhaseCode], map: "uq_sub_phase")
  @@index([configSetId, phaseCode, displayOrder], map: "idx_subphase_set")
  @@map("sub_phase_order")
}

// ============================================================================
// Bảng 8: Lịch làm việc & ngày nghỉ
// ============================================================================
model WorkCalendar {
  // Lịch built-in (VN_STANDARD | JP_STANDARD): project_key NULL — dùng chung,
  // chỉ ADMIN sửa. Lịch riêng của dự án: project_key khác NULL, ID sinh cuid,
  // PM của dự án sửa được (clone từ built-in qua service riêng).
  calendarId String @id @map("calendar_id") @db.VarChar(32)
  projectKey String? @map("project_key") @db.VarChar(32)
  timezone   String @db.VarChar(48)
  // Bitmask 7 bit. Bit 0 = Thứ Hai … bit 6 = Chủ nhật (theo luxon: T2=1..CN=7).
  // KHÔNG giống Date.getDay() của JavaScript (CN=0) — nhầm chỗ này lệch cả tuần.
  // T2–T6 = 31, T2–T7 = 63. Migration 20260811140000 thêm CHECK: 1..127 và bắt
  // buộc có Thứ Hai — mask 1-indexed (126, 62) từng làm Thứ Hai biến mất khỏi
  // biểu đồ; Prisma không mô tả được CHECK nên chỉ nhắc ở đây.
  workdaysMask Int      @map("workdays_mask") @db.SmallInt
  hoursPerDay  Decimal  @default(8.0) @map("hours_per_day") @db.Decimal(4, 2)

  holidays       CalendarHoliday[]
  makeupWorkdays CalendarMakeupWorkday[]
  trackedEpics   TrackedEpic[]
  project        Project?                @relation(fields: [projectKey], references: [projectKey], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectKey], map: "idx_calendar_project")
  @@map("work_calendar")
}

model CalendarHoliday {
  calendarId  String   @map("calendar_id") @db.VarChar(32)
  holidayDate DateTime @map("holiday_date") @db.Date
  label       String?

  calendar WorkCalendar @relation(fields: [calendarId], references: [calendarId], onDelete: Cascade)

  @@id([calendarId, holidayDate])
  @@map("calendar_holiday")
}

// Ngày LÀM BÙ — cuối tuần (theo mask) được xếp làm việc để bù cho một ngày nghỉ
// khác. Ngược nghĩa với calendar_holiday: engine tính đường Kế hoạch trên ngày
// này NHƯ ngày làm việc bình thường, và biểu đồ Burndown KHÔNG bôi xám nó.
model CalendarMakeupWorkday {
  calendarId String   @map("calendar_id") @db.VarChar(32)
  workDate   DateTime @map("work_date") @db.Date
  label      String?

  calendar WorkCalendar @relation(fields: [calendarId], references: [calendarId], onDelete: Cascade)

  @@id([calendarId, workDate])
  @@map("calendar_makeup_workday")
}

// ============================================================================
// Bảng 9: Ngày plan/actual của từng Phase, tổng hợp từ Sub-task (PRD §2.7)
// Tính lại sau MỖI LẦN đồng bộ — KHÔNG đóng băng.
// ============================================================================
model PhaseRollup {
  epicKey   String @map("epic_key") @db.VarChar(32)
  phaseCode String @map("phase_code") @db.VarChar(24)

  // MIN(wbs_start_date) / MAX(wbs_end_date) của các Sub-task đang hoạt động.
  // NULL = mọi Sub-task đều thiếu ngày → KHÔNG vẽ đường Kế hoạch cho Phase này.
  planStart    DateTime? @map("plan_start") @db.Date
  planEnd      DateTime? @map("plan_end") @db.Date
  planWorkdays Int?      @map("plan_workdays")

  // MIN/MAX ngày thực tế, suy ra từ changelog + worklog (PRD §2.7.2)
  actualStart DateTime? @map("actual_start") @db.Date
  actualEnd   DateTime? @map("actual_end") @db.Date
  // true = Phase chưa xong hết, actualEnd mới chỉ là tạm tính
  actualEndIsProvisional Boolean @default(false) @map("actual_end_is_provisional")

  totalOriginalS   BigInt @default(0) @map("total_original_s")
  subtaskCount     Int    @default(0) @map("subtask_count")
  missingDateCount Int    @default(0) @map("missing_date_count") // số Sub-task thiếu wbs_*

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  epic TrackedEpic @relation(fields: [epicKey], references: [epicKey], onDelete: Cascade)

  @@id([epicKey, phaseCode])
  @@map("phase_rollup")
}

// ============================================================================
// Bảng 10: Lịch sử dịch chuyển kế hoạch
//
// Vì đã bỏ baseline, đường Kế hoạch tự trôi theo dữ liệu Jira. Bảng này là
// tuyến phòng thủ chính cho rủi ro R-11: ghi lại MỌI lần ngày kết thúc của một
// Phase bị đẩy lùi, để độ trễ không bị giấu đi.
// ============================================================================
model PlanShiftHistory {
  id        BigInt @id @default(autoincrement())
  epicKey   String @map("epic_key") @db.VarChar(32)
  phaseCode String @map("phase_code") @db.VarChar(24)

  shiftType String   @map("shift_type") @db.VarChar(16) // START_MOVED | END_MOVED
  fromDate  DateTime @map("from_date") @db.Date
  toDate    DateTime @map("to_date") @db.Date
  // số dương = bị lùi, âm = kéo sớm lên
  shiftedWorkdays Int @map("shifted_workdays")

  // Sub-task nào gây ra thay đổi này (để PM truy nguyên)
  causedByKeys String[] @default([]) @map("caused_by_keys")

  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz(6)

  @@index([epicKey, detectedAt(sort: Desc)], map: "idx_planshift_epic")
  @@map("plan_shift_history")
}

// ============================================================================
// Bảng 11: Ngày plan/actual của TỪNG Sub-task (PRD §2.7.2, §6)
//
// `phase_rollup` giữ bản TỔNG HỢP theo Phase; bảng này giữ bản CHI TIẾT theo
// ticket mà mỗi ô Signboard cần để so kế hoạch↔thực tế của chính nó. `actual_*`
// suy ra từ changelog + worklog nên do job dựng lại GHI (dùng lại
// engine.resolveSubtaskActualDates) — KHÔNG phải view SQL, vì việc tra
// status_id → nhóm trạng thái cần bảng nằm ở Redis.
// ============================================================================
model SubtaskActualDates {
  issueKey String @id @map("issue_key") @db.VarChar(32)

  actualStart DateTime? @map("actual_start") @db.Date
  actualEnd   DateTime? @map("actual_end") @db.Date
  // true = chưa từng Done; actual_end mới chỉ là ngày worklog cuối, tạm tính.
  actualEndIsProvisional Boolean @default(false) @map("actual_end_is_provisional")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  issue JiraIssue @relation(fields: [issueKey], references: [issueKey], onDelete: Cascade, onUpdate: Cascade)

  @@map("subtask_actual_dates")
}

// ============================================================================
// Bảng 12: Người dùng ứng dụng — NGUỒN SỰ THẬT của phân quyền (role/projects).
//
// Vì sao cần bảng này (mô hình SSO B1): cổng (auth proxy) chỉ khẳng định DANH
// TÍNH đã xác thực và bơm vào header `x-user-id`. API KHÔNG tin `role`/`projects`
// từ header — bất kỳ header nào cũng có thể bị giả nếu cổng cấu hình sai — mà
// tra chính bảng này. Nhờ vậy Admin quản lý ai-là-PM-của-project-nào ngay trong
// hệ thống, có version và audit được, thay vì nhồi vào cấu hình IdP/proxy.
//
// `user_id` là danh tính ổn định do IdP cấp (thường là email đã chuẩn hoá về
// chữ thường). Dài 254 = giới hạn địa chỉ email theo RFC 5321.
// ============================================================================
model AppUser {
  userId String @id @map("user_id") @db.VarChar(254)

  // Role TOÀN CỤC: ADMIN | MEMBER — khớp GLOBAL_ROLE ở @app/shared.
  // ADMIN thấy/quản mọi dự án. MEMBER chỉ thấy dự án mình là thành viên —
  // role trong từng dự án (PM | VIEWER) nằm ở bảng project_member.
  // (PM/VIEWER toàn cục cũ đã chuyển thành membership per-project ở migration
  // 20260812000000_multi_tenant.)
  role String @db.VarChar(16)

  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships ProjectMember[]

  @@map("app_user")
}

// ============================================================================
// Bảng 14: Thành viên dự án — role RIÊNG trong từng dự án (multi-tenant).
//
// Một người có thể là PM dự án A đồng thời VIEWER dự án B. Non-admin chỉ nhìn
// thấy dự án mình có dòng ở đây; ADMIN toàn cục không cần dòng nào.
// ============================================================================
model ProjectMember {
  projectKey String @map("project_key") @db.VarChar(32)
  userId     String @map("user_id") @db.VarChar(254)

  // PM | VIEWER — role trong PHẠM VI dự án này, khớp PROJECT_ROLE ở @app/shared.
  role String @db.VarChar(16)

  addedBy String   @map("added_by") @db.VarChar(254)
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)
  user    AppUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([projectKey, userId])
  @@index([userId], map: "idx_member_user")
  @@map("project_member")
}

// ============================================================================
// Bảng 13: Project — GỐC TENANT của multi-tenant (từ 20260812000000).
//
// Tenant định danh bằng chính Jira project key (chữ HOA, ví dụ PAY, CRM) —
// duy nhất TOÀN HỆ THỐNG. Vì issue key Jira luôn có dạng `<KEY>-<n>`, key
// duy nhất kéo theo issue_key không bao giờ trùng giữa các tenant, kể cả khi
// hai tenant nằm trên hai Jira site khác nhau. Giới hạn chấp nhận: hai site
// cùng có project key `PAY` thì không thể cùng làm tenant ở đây.
//
// Mỗi tenant tự chứa: kết nối Jira riêng (base URL/email/token mã hóa),
// field mapping riêng (thay config/jira-fields.yaml), cấu trúc phân tầng
// riêng (hierarchy_depth), timezone/lịch mặc định, và danh sách thành viên
// (project_member). Mọi cột kết nối NULL = dùng env JIRA_* (chế độ 1 site cũ).
// ============================================================================
model Project {
  projectKey  String  @id @map("project_key") @db.VarChar(32)
  displayName String? @map("display_name")

  // ACTIVE | ARCHIVED — ARCHIVED: ẩn khỏi switcher, job đêm bỏ qua.
  status String @default("ACTIVE") @db.VarChar(16)

  // ---- Kết nối Jira riêng của tenant (yêu cầu 2 của multi-tenant) ----
  // Cả ba NULL = fallback về env JIRA_BASE_URL/JIRA_EMAIL/JIRA_API_TOKEN.
  jiraBaseUrl String? @map("jira_base_url")
  jiraEmail   String? @map("jira_email") @db.VarChar(254)
  // API token mã hóa AES-256-GCM bằng APP_ENCRYPTION_KEY, định dạng
  // "v1:<iv b64>:<tag b64>:<ct b64>" (xem packages/db/src/crypto/secret-box.ts).
  // KHÔNG BAO GIỜ trả cột này ra API — token là write-only từ phía client.
  jiraTokenEnc String? @map("jira_token_enc")

  // Field mapping admin nhập (cùng shape với config/jira-fields.yaml) và bản
  // đã resolve ra custom-field ID (ghi bởi endpoint "Test connection").
  jiraFieldsJson   Json? @map("jira_fields_json")
  jiraResolvedJson Json? @map("jira_resolved_json")

  // Số tầng DƯỚI tracked root: 1..4. 2 = Epic/Task/Subtask như trước đây.
  // Tầng 0 luôn là root; tầng lá mang vai trò SUBTASK, lá-1 mang vai trò TASK.
  hierarchyDepth Int @default(2) @map("hierarchy_depth") @db.SmallInt

  timezone          String  @default("Asia/Ho_Chi_Minh") @db.VarChar(48)
  defaultCalendarId String? @map("default_calendar_id") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members       ProjectMember[]
  issues        JiraIssue[]
  trackedEpics  TrackedEpic[]
  configSets    PhaseConfigSet[]
  calendars     WorkCalendar[]

  @@map("project")
}
