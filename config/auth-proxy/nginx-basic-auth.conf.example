# Cấu hình MẪU — nginx + Basic Auth (PHƯƠNG ÁN TẠM để test, KHÔNG phải SSO).
#
# Dùng khi chưa tạo được App registration Entra: bảo vệ app cho vài người test
# bằng Basic Auth. Cùng mô hình header với SSO — nginx đặt `x-user-id` = username
# đã xác thực (đặt username = EMAIL để khớp bảng `app_user`), và xoá header giả.
# API không đổi dòng code nào; role vẫn tra `app_user`.
#
# ⚠️ ĐÂY LÀ BẢN TẠM — thay bằng SSO (nginx.conf.example) khi có app Entra:
#   - BẮT BUỘC HTTPS: Basic Auth gửi mật khẩu (base64) theo MỖI request.
#   - Mật khẩu do admin phát tay, không phải SSO; không có đăng xuất/hết phiên.
#   - API (cổng 3000) chỉ nghe từ nginx, KHÔNG expose ra Internet (HOST=127.0.0.1).

upstream burndown_api {
  server 127.0.0.1:3000;
}

server {
  listen 443 ssl;
  server_name burndown.your-company.com;

  # ssl_certificate ... ; ssl_certificate_key ... ;

  # Cả site nằm sau Basic Auth. File mật khẩu: username = EMAIL (chữ thường) để
  # khớp `app_user.user_id`. Tạo/thêm người: xem README (htpasswd -B ...).
  auth_basic           "Burndown (test)";
  auth_basic_user_file /etc/nginx/burndown.htpasswd;

  # SPA tĩnh. `location /` không proxy nên không cần đặt header danh tính ở đây.
  location / {
    root /var/www/burndown;      # nơi đặt bản build của apps/web (apps/web/dist)
    try_files $uri /index.html;
  }

  location /api/ {
    # BẪY NGINX: nếu location này có bất kỳ proxy_set_header nào thì nó KHÔNG kế
    # thừa proxy_set_header ở cấp server. Vì vậy đặt TẤT CẢ header cần thiết NGAY
    # TẠI ĐÂY — nơi request thật sự đi tới API.
    #
    # DANH TÍNH: x-user-id = user đã xác thực ($remote_user). proxy_set_header GHI
    # ĐÈ mọi header cùng tên client gửi, nên đây cũng là bước XOÁ HEADER GIẢ.
    proxy_set_header X-User-Id       $remote_user;
    proxy_set_header X-User-Role     "";
    proxy_set_header X-User-Projects "";
    proxy_set_header Host            $host;

    proxy_pass http://burndown_api;
  }

  # Health check không cần đăng nhập (để LB thăm dò).
  location = /healthz {
    auth_basic off;
    proxy_pass http://burndown_api;
  }
}
