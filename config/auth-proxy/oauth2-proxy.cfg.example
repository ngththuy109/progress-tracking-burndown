# Cấu hình MẪU cho oauth2-proxy — Microsoft Entra ID (Azure AD), mô hình SSO B1.
#
# oauth2-proxy lo phần OIDC: chuyển hướng người dùng tới Entra ID, đổi mã lấy
# token, xác minh, giữ phiên bằng cookie đã ký. Nó KHÔNG quyết vai trò — vai trò
# tra ở bảng `app_user` trong API. Nhiệm vụ duy nhất ở đây: khẳng định DANH TÍNH.
#
# Chạy: oauth2-proxy --config /etc/oauth2-proxy.cfg
# Tài liệu: https://oauth2-proxy.github.io/oauth2-proxy/

http_address = "127.0.0.1:4180"

# -- Entra ID (Azure AD) qua provider OIDC chung --
# Dùng `provider = "oidc"` với endpoint v2.0 chạy được mọi phiên bản oauth2-proxy.
# (Bản ≥ 7.7 có `provider = "entra-id"` với nhiều tuỳ chọn hơn — đổi nếu cần.)
provider        = "oidc"

# Endpoint v2.0, SINGLE-TENANT: thay <TENANT_ID> bằng "Directory (tenant) ID".
# Chính issuer gắn tenant này đã giới hạn chỉ người trong tổ chức đăng nhập được.
oidc_issuer_url = "https://login.microsoftonline.com/<TENANT_ID>/v2.0"

# "Application (client) ID" và một Client secret tạo ở App registrations.
client_id       = "<APPLICATION_CLIENT_ID>"
client_secret   = "<CLIENT_SECRET_VALUE>"

redirect_url    = "https://burndown.your-company.com/oauth2/callback"

scope           = "openid email profile"

# Entra trả email ở claim `email` KHI đã bật optional claim "email" (Token
# configuration). Nếu tổ chức không set `mail`, claim `email` rỗng — khi đó đổi
# sang UPN:
# oidc_email_claim = "preferred_username"

# Đã single-tenant nên chỉ người trong tổ chức vào được; vẫn nên liệt kê domain
# thật để chặt hơn. Để ["*"] nếu chấp nhận giới hạn bằng tenant + app assignment.
email_domains   = ["your-company.com"]

# Chuỗi ngẫu nhiên 32 byte để ký cookie phiên. TUYỆT ĐỐI không commit.
# Tạo: openssl rand -base64 32
cookie_secret   = "<COOKIE_SECRET_32_BYTE>"
cookie_secure   = true
cookie_samesite = "lax"

# QUAN TRỌNG: trả email đã xác thực về nginx qua header `X-Auth-Request-Email`
# (nginx đọc ở auth_request_set). Không bật thì cổng không biết đặt x-user-id.
set_xauthrequest = true

# oauth2-proxy đứng sau nginx nên tin proxy để đọc X-Forwarded-*.
reverse_proxy    = true
