# Sao chép thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
#
# `pnpm dev` (api + worker) tự nạp file `.env` này ở GỐC repo. Biến thật trong
# môi trường (CI/Docker/shell export) luôn thắng `.env` — nên đặt ở đây an toàn
# cho local, còn production cứ dùng biến môi trường thật như thường.

# ---- PostgreSQL ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/burndown?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Jira Cloud ----
# Tài khoản dịch vụ, chỉ cần quyền Browse Projects (CONVENTIONS.md C-9: cấm ghi token vào log)
JIRA_BASE_URL="https://your-site.atlassian.net"
JIRA_EMAIL="service-account@example.com"
JIRA_API_TOKEN="thay-bang-token-that"

# ---- Link "mở ticket" trên giao diện (TÙY CHỌN) ----
# Frontend KHÔNG đọc JIRA_BASE_URL ở trên (biến đó chỉ có phía server). Muốn ô của
# bảng Signboard hiện nút MỞ / COPY link chi tiết ticket (rê chuột vào ô) thì đặt
# VITE_JIRA_BASE_URL — thường trùng JIRA_BASE_URL. Bỏ trống = tắt link, ô chỉ còn
# copy được MÃ ticket. CHỈ ảnh hưởng `vite dev` / bản build web.
# VITE_JIRA_BASE_URL="https://your-site.atlassian.net"

# ---- Xác thực / phân quyền (SSO qua cổng — xem config/auth-proxy/) ----
# API KHÔNG tự đăng nhập người dùng. Một auth proxy (oauth2-proxy / IAP / ALB…)
# đứng trước, xác thực SSO rồi đặt header danh tính. API tra vai trò ở bảng
# `app_user`, KHÔNG tin `role` từ header.
#
# Tên header danh tính do cổng đặt (mặc định `x-user-id`). Đổi cho khớp proxy:
#   oauth2-proxy → x-forwarded-email · GCP IAP → x-goog-authenticated-user-email
# AUTH_IDENTITY_HEADER=x-user-id
#
# Email luôn được coi là ADMIN — dùng để MỒI admin đầu tiên khi bảng app_user
# còn rỗng (nếu không sẽ deadlock: chưa ai là admin thì không ai cấp quyền được).
# Phân tách bằng dấu phẩy.
# AUTH_BOOTSTRAP_ADMINS=you@your-company.com
#
# Vai trò cho người đã đăng nhập SSO nhưng CHƯA có trong app_user:
#   VIEWER (mặc định) = xem được, không sửa · PM · ADMIN · NONE = từ chối hẳn
# AUTH_DEFAULT_ROLE=VIEWER
#
# ---- Danh tính giả khi chạy DEV qua trình duyệt (chỉ local, chỉ `pnpm dev`) ----
# Ở local KHÔNG có cổng SSO nên trình duyệt không gửi `x-user-id` → mọi thao tác
# GHI (thêm Epic, sửa cấu hình…) trả 401. Đặt VITE_DEV_USER để Vite dev proxy tự
# chèn `x-user-id` vào request /api — đóng vai cổng SSO ở local. Kết hợp với
# AUTH_BOOTSTRAP_ADMINS cùng email thì tài khoản đó thành ADMIN và thêm được Epic.
# CHỈ ảnh hưởng `vite dev`; bản build production KHÔNG dùng biến này. Xem AUTH.md §9.
# VITE_DEV_USER=admin@test.test
# VITE_DEV_IDENTITY_HEADER=x-user-id      # đổi cho khớp cổng khác (hiếm khi cần)

# ---- Seed admin đầu tiên khi deploy (TÙY CHỌN) ----
# `pnpm seed:admin` (đặt SAU `pnpm db:migrate`) tạo sẵn một admin, idempotent.
# Chưa đặt SEED_ADMIN_EMAIL thì bước seed bỏ qua. KHÔNG commit mật khẩu thật.
# SEED_ADMIN_EMAIL=you@your-company.com
# SEED_ADMIN_PASSWORD=doi-mat-khau-nay        # chỉ khi dùng Basic Auth (tạo login htpasswd)
# SEED_ADMIN_HTPASSWD=/etc/nginx/burndown.htpasswd

# ---- Hạn chót khởi động (TÙY CHỌN) ----
# Chặn treo VÔ HẠN khi một phụ thuộc không phản hồi lúc khởi động — ví dụ Redis
# accept TCP nhưng không trả lời lệnh nào. Quá hạn thì tiến trình thoát hẳn (exit 1)
# kèm thông báo rõ để trình giám sát dựng lại, thay vì "sống mà không lắng nghe".
# Bỏ trống để dùng mặc định. Áp cho CẢ api lẫn worker.
# REDIS_READY_TIMEOUT_MS=10000   # hạn ping Redis lúc khởi động (mặc định 10000)
# BOOTSTRAP_TIMEOUT_MS=60000     # hạn cho TOÀN BỘ bước khởi động (mặc định 60000)
