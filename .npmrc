# pnpm dùng symlink chặt, còn Prisma generate lại tự dò `@prisma/client` bằng
# đường dẫn thật — nó không nhìn thấy package qua symlink và báo
# "Could not resolve @prisma/client".
#
# Hoist riêng hai package của Prisma ra node_modules gốc để CLI dò được.
# KHÔNG dùng `node-linker=hoisted` cho cả workspace: làm vậy sẽ mất hẳn lớp
# bảo vệ phantom dependency của pnpm, và các hàng rào kiến trúc ở T-01 dựa vào
# việc package chỉ thấy đúng thứ mình khai.
public-hoist-pattern[]=@prisma/client
public-hoist-pattern[]=prisma

strict-peer-dependencies=false

# `prisma generate` tự chạy `pnpm add @prisma/client@<ver>` khi nó nghĩ client
# chưa được cài. Ở workspace root, pnpm CHẶN `add` nếu thiếu cờ `-w` — mà Prisma
# không biết điều đó, nên báo lỗi khó hiểu:
#   "Command failed with exit code 1: pnpm add @prisma/client@6.19.3 --silent"
#
# Tắt kiểm tra này để lệnh nội bộ của Prisma chạy được.
ignore-workspace-root-check=true
